{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    }
  },
  "hosting": [
    {
      "target": "ipcc-land-stratification-for-nggi",
      "public": "frontend/build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "climate-and-ecological-zoning",
      "public": "discontinued-hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://ipcc-land-stratification-for-nggi.web.app",
          "type": 301
        },
        {
          "source": "/**",
          "destination": "https://ipcc-land-stratification-for-nggi.web.app",
          "type": 301
        }
      ]
    }
  ]
}

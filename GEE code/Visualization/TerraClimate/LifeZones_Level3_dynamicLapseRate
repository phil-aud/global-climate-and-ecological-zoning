var row = function(icon, text) { return ui.Panel([makeIcon(icon), ui.Label(text)], ui.Panel.Layout.Flow('horizontal'), {margin: '4px 0'}); };
legend.add(row('', 'Basal — no symbol'));
legend.add(row(svgRight, 'Premontane — right diagonal stripes'));
legend.add(row(svgLeft, 'Montane — left diagonal stripes'));

// --- Overlay: altitude-belt symbols (Basal, Premontane, Montane, Subalpine, Alpine, Nival)
var hlzImg = hlz;
var belt = hlzImg.divide(10).floor().mod(10);
var px = ee.Image.pixelLonLat().select('longitude').multiply(100000).toInt();
var py = ee.Image.pixelLonLat().select('latitude').multiply(100000).toInt();
var period = 12; var width = 4;
var rightDiag = px.add(py).mod(period).lt(width);
var leftDiag  = px.subtract(py).abs().mod(period).lt(width);
var xPattern  = rightDiag.or(leftDiag);
var points    = px.mod(period).eq(0).and(py.mod(period).eq(0));
var snowflake = rightDiag.or(leftDiag).or(points);
var basalMask     = belt.eq(1).selfMask();
var premontaneMask= belt.eq(2).selfMask();
var montaneMask   = belt.eq(3).selfMask();
var subalpineMask = belt.eq(4).selfMask();
var alpineMask    = belt.eq(5).selfMask();
var nivalMask     = belt.eq(6).selfMask();
var pat_premontane = rightDiag.updateMask(premontaneMask);
var pat_montane    = leftDiag.updateMask(montaneMask);
var pat_subalpine  = xPattern.updateMask(subalpineMask);
var pat_alpine     = points.updateMask(alpineMask);
var pat_nival      = snowflake.updateMask(nivalMask);
var patternOverlay = pat_premontane.unmask(0)
  .add(pat_montane.unmask(0))
  .add(pat_subalpine.unmask(0))
  .add(pat_alpine.unmask(0))
  .add(pat_nival.unmask(0));
Map.addLayer(patternOverlay.updateMask(patternOverlay), {palette: ['000000'], opacity: 0.45}, 'HLZ Level 3 - Altitude Belt Symbols');


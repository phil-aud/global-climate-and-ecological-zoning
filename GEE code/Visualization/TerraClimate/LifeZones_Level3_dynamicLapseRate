var svgDot   = encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="28" height="20"><rect width="28" height="20" fill="white"/><g fill="black"><circle cx="7" cy="6" r="2"/><circle cx="21" cy="6" r="2"/><circle cx="7" cy="14" r="2"/><circle cx="21" cy="14" r="2"/></g></svg>');

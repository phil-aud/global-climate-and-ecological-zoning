/////////////////////////////////////////////////////////////////////////////
//////////////// Median / Min / Max Temperature per GCZ /////////////////////
/////////////////////////////////////////////////////////////////////////////
//
// Standalone GEE script — CRU TS 4.09
// For each Global Climate Zone (GCZ, IPCC Vol4 Ch3 §3A.5.1) computes the
// median, minimum and maximum mean annual temperature (MAT, °C) over
// the reference period 1995–2024.
//
// IMPORTANT: this uses MEAN ANNUAL TEMPERATURE (not biotemperature).
// Biotemperature would clip monthly means to [0, 30] °C; here we use
// the raw monthly mean temperatures.
//
// Inputs:
//   • CRU TS 4.09 monthly mean temperature image (b1..b1488 → 1901-01..2024-12)
//   • Precomputed GCZ image (1995–2024, CRU TS 4.09)
//
// Output: a printed table {zone, label, median, min, max} and a CSV export.
/////////////////////////////////////////////////////////////////////////////

// ── Configuration ───────────────────────────────────────────────────────────
var START_YEAR = 1995;
var END_YEAR   = 2024;
var CRU_MIN_YEAR = 1901;

// CRU TS 4.09 monthly temperature (°C) and precomputed GCZ asset
var cruTmp = ee.Image('projects/ee-philaudebert/assets/CRU/CRU409_1901-2024/cru_ts409_1901-2024_tmp');
var gcz    = ee.Image('projects/ee-philaudebert/assets/HoldridgeLifeZones/IPCCversions/IPCC_GlobalClimateZones_1995-2024_CRU409');

// GCZ class labels (1..10) — match the IPCC Vol4 Ch3 §3A.5.1 climate zones
var GCZ_LABELS = {
  1:  'Tropical Wet',
  2:  'Tropical Moist',
  3:  'Tropical Dry',
  4:  'Warm Temperate Moist',
  5:  'Warm Temperate Dry',
  6:  'Cool Temperate Moist',
  7:  'Cool Temperate Dry',
  8:  'Boreal Moist',
  9:  'Boreal Dry',
  10: 'Polar'
};

// ── Build mean annual temperature image (1995–2024 mean of monthly means) ──
var startIdx = (START_YEAR - CRU_MIN_YEAR) * 12;          // inclusive
var endIdx   = (END_YEAR   - CRU_MIN_YEAR + 1) * 12 - 1;  // inclusive
var bandNames = [];
for (var i = startIdx; i <= endIdx; i++) bandNames.push('b' + (i + 1));

var matImage = cruTmp.select(bandNames).reduce(ee.Reducer.mean()).rename('mat');

// ── Per-zone reduction ──────────────────────────────────────────────────────
// Stack: band 0 = MAT, band 1 = GCZ class. Group by class index.
var stack = matImage.addBands(gcz.rename('zone'));

var combined = ee.Reducer.percentile([50], ['p50'])
  .combine({reducer2: ee.Reducer.minMax(), sharedInputs: true})
  .group({groupField: 1, groupName: 'zone'});

// Use the GCZ asset's native projection (~1 km, but underlying CRU is ~55 km).
// bestEffort + a coarser scale keep the global reduction tractable.
var stats = stack.reduceRegion({
  reducer: combined,
  geometry: ee.Geometry.Rectangle([-180, -60, 180, 85], null, false),
  scale: 5566,           // ≈ 0.05° at the equator (CRU is ~0.5°)
  maxPixels: 1e13,
  bestEffort: true,
  tileScale: 4
});

// ── Format as a FeatureCollection / table ──────────────────────────────────
var groups = ee.List(stats.get('groups'));
var rows = ee.FeatureCollection(groups.map(function (g) {
  g = ee.Dictionary(g);
  var zone = ee.Number(g.get('zone'));
  return ee.Feature(null, {
    zone:   zone,
    label:  ee.Dictionary(GCZ_LABELS).get(zone.format('%d'), 'Unknown'),
    median: ee.Number(g.get('p50')).multiply(100).round().divide(100),
    min:    ee.Number(g.get('min')).multiply(100).round().divide(100),
    max:    ee.Number(g.get('max')).multiply(100).round().divide(100)
  });
}));

print('CRU TS 4.09 — Median / Min / Max MAT (°C) per GCZ, 1995–2024', rows);

// CSV export
Export.table.toDrive({
  collection: rows,
  description: 'MedianTemperatureGCZ_CRU409_1995-2024',
  fileFormat: 'CSV',
  selectors: ['zone', 'label', 'median', 'min', 'max']
});

/////////////////////////////////////////////////////////////////////////////
/////////////////////////// Holdridge Life Zones/////////////////////////////
/////////////////////////////////////////////////////////////////////////////
//
// Self-contained: no require() needed. Paste directly into GEE Code Editor.
//
// Dataset: TerraClimate (IDAHO_EPSCOR/TERRACLIMATE)
// Classification: Holdridge Life Zone ecology (Holdridge 1967)
// https://reddcr.go.cr/sites/default/files/centro-de-documentacion/holdridge_1966_-_life_zone_ecology.pdf
//
// IPCC Vol. 4.3 Global Ecological Zones (GEZ) — Level 1
// Remapped from full HLZ classification (3-digit codes) to IPCC GEZ classes (2-digit codes)
//
// Band mapping:
//   pr   → precipitation (mm/month, scale 1)
//   pet  → reference evapotranspiration (mm/month, scale 0.1)
//   tmmn → min temperature (°C, scale 0.1)
//   tmmx → max temperature (°C, scale 0.1)   → mean = (tmmn + tmmx) × 0.05
//
// Frost line: a pixel has frost if any individual monthly tmmn < 0°C in the period.
// Subtropical basal = no frost in 18-24°C range; Warm Temperate basal = frost in 18-24°C range.
// Above basal in the 18-24°C range: subtropical geometry applies regardless of frost.
//
// TerraClimate availability: 1958–present.

// =========================================================================
// Configuration — edit these to change the period
// =========================================================================
var START_YEAR = 1995;
var END_YEAR   = 2024;

// =========================================================================
// Datasets
// =========================================================================
var terraClimate = ee.ImageCollection("IDAHO_EPSCOR/TERRACLIMATE");
var elevation    = ee.Image("USGS/GTOPO30");

// =========================================================================
// Climate data helpers
// =========================================================================

// 12-image IC: monthly mean temperature (°C) = (tmmn + tmmx) × 0.05
var tcMonthlyMeanTemp = function(startYear, endYear) {
  var filtered = terraClimate
    .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
    .map(function(img) {
      return img.select('tmmn').add(img.select('tmmx'))
                .multiply(0.05).rename('tmp')
                .copyProperties(img, ['system:time_start']);
    });
  return ee.ImageCollection(ee.List.sequence(1, 12).map(function(m) {
    return filtered.filter(ee.Filter.calendarRange(m, m, 'month')).mean().rename('tmp');
  }));
};

// 12-image IC: monthly mean precipitation (mm/month)
var tcMonthlyMeanPre = function(startYear, endYear) {
  var filtered = terraClimate
    .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
    .map(function(img) {
      return img.select('pr').rename('pr').copyProperties(img, ['system:time_start']);
    });
  return ee.ImageCollection(ee.List.sequence(1, 12).map(function(m) {
    return filtered.filter(ee.Filter.calendarRange(m, m, 'month')).mean().rename('pr');
  }));
};

// Single-band image: mean annual total PET (mm/year)
var tcAnnualMeanPet = function(startYear, endYear) {
  var filtered = terraClimate
    .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
    .map(function(img) {
      return img.select('pet').multiply(0.1).rename('pet')
                .copyProperties(img, ['system:time_start']);
    });
  return ee.ImageCollection(ee.List.sequence(1, 12).map(function(m) {
    return filtered.filter(ee.Filter.calendarRange(m, m, 'month')).mean().rename('pet');
  })).sum();
};

// =========================================================================
// Full HLZ classification
// =========================================================================
var holdridgeLifeZones = function(startYear, endYear) {
  var tcTemp    = tcMonthlyMeanTemp(startYear, endYear);
  var tcPre     = tcMonthlyMeanPre(startYear, endYear);
  var annualPet = tcAnnualMeanPet(startYear, endYear);

  // -- Biotemperature: clip monthly temp to [0, 30] °C --
  var tb = tcTemp.toBands();
  var mmb = function(b) {
    return tb.select(b).max(ee.Image(0)).min(ee.Image(30)).rename('b');
  };
  var tBio = ee.ImageCollection.fromImages([
    mmb(0), mmb(1), mmb(2), mmb(3), mmb(4),  mmb(5),
    mmb(6), mmb(7), mmb(8), mmb(9), mmb(10), mmb(11)
  ]).sum().divide(12);

  // ── Fixed lapse rate (Holdridge original: 6°C per 1000m) ─────────
  var lapseRate = 6;          // °C per 1000m
  var k         = 1000 / 6;   // m per °C (~166.667), constant

  // ── Sea-level biotemperature ──────────────────────────────────────
  var t0Bio = tBio.add(
    tBio.gt(0).multiply(elevation.divide(1000).multiply(lapseRate))
  );

  // -- Frost: any month in the period with monthly mean tmmn < 0°C --
  var hasFrost = terraClimate
    .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
    .select('tmmn')
    .min()
    .multiply(0.1)
    .lt(0);

  // ── Latitudinal regions ───────────────────────────────────────────
  var el = elevation;

  var frostLineEl = t0Bio.subtract(18).multiply(k);

  var tropical      = t0Bio.gte(24);
  var subtropical   = t0Bio.gte(18).and(t0Bio.lt(24));
  var warmTemperate = t0Bio.gte(12).and(t0Bio.lt(18));
  var coolTemperate = t0Bio.gte(6).and(t0Bio.lt(12));
  var boreal        = t0Bio.gte(3).and(t0Bio.lt(6));
  var subpolar      = t0Bio.gte(1.5).and(t0Bio.lt(3));
  var polar         = t0Bio.gte(0).and(t0Bio.lt(1.5));

  // ── Altitudinal belt baselines ────────────────────────────────────
  var trop_base = t0Bio.subtract(24).multiply(k);
  var subt_base = t0Bio.subtract(18).multiply(k);
  var wt_base   = t0Bio.subtract(12).multiply(k);
  var ct_base   = t0Bio.subtract(6).multiply(k);
  var bor_base  = t0Bio.subtract(3).multiply(k);
  var sp_base   = t0Bio.subtract(1.5).multiply(k);
  var pol_base  = t0Bio.multiply(k);

  // ── TROPICAL (x1 = 24) ───────────────────────────────────────────
  var tropicalBasal        = tropical.multiply(el.lte(trop_base));
  var tropicalPremontane   = tropical.multiply(el.gt(trop_base).and(el.lte(trop_base.add(1000))));
  var tropicalLowerMontane = tropical.multiply(el.gt(trop_base.add(1000)).and(el.lte(trop_base.add(2000))));
  var tropicalMontane      = tropical.multiply(el.gt(trop_base.add(2000)).and(el.lte(trop_base.add(3000))));
  var tropicalSubalpine    = tropical.multiply(el.gt(trop_base.add(3000)).and(el.lte(trop_base.add(3500))));
  var tropicalAlpine       = tropical.multiply(el.gt(trop_base.add(3500)).and(el.lte(trop_base.add(3750))));
  var tropicalNival        = tropical.multiply(el.gt(trop_base.add(3750)));

  // ── SUBTROPICAL (x1 = 18) ────────────────────────────────────────
  // subtropicalBasal: 18-24°C range, below basal threshold, NO frost
  // Above basal: entire 18-24°C range uses subtropical geometry regardless of frost
  var subtropicalBasal        = subtropical.multiply(el.lte(subt_base).and(hasFrost.not()));
  var subtropicalLowerMontane = subtropical.multiply(el.gt(subt_base).and(el.lte(subt_base.add(1000))));
  var subtropicalMontane      = subtropical.multiply(el.gt(subt_base.add(1000)).and(el.lte(subt_base.add(2000))));
  var subtropicalSubalpine    = subtropical.multiply(el.gt(subt_base.add(2000)).and(el.lte(subt_base.add(2500))));
  var subtropicalAlpine       = subtropical.multiply(el.gt(subt_base.add(2500)).and(el.lte(subt_base.add(2750))));
  var subtropicalNival        = subtropical.multiply(el.gt(subt_base.add(2750)));

  // ── WARM TEMPERATE ────────────────────────────────────────────────
  // warmTemperateBasal: 12-18°C basal OR 18-24°C basal WITH frost
  // Above basal: only 12-18°C range uses warm temperate geometry
  var warmTemperateBasal     = warmTemperate.multiply(el.lte(wt_base))
                                 .or(subtropical.multiply(el.lte(subt_base).and(hasFrost)));
  var warmTemperateMontane   = warmTemperate.multiply(el.gt(wt_base)          .and(el.lte(wt_base.add(1000))));
  var warmTemperateSubalpine = warmTemperate.multiply(el.gt(wt_base.add(1000)).and(el.lte(wt_base.add(1500))));
  var warmTemperateAlpine    = warmTemperate.multiply(el.gt(wt_base.add(1500)).and(el.lte(wt_base.add(1750))));
  var warmTemperateNival     = warmTemperate.multiply(el.gt(wt_base.add(1750)));

  // ── COOL TEMPERATE (x1 = 6) ──────────────────────────────────────
  var coolTemperateBasal     = coolTemperate.multiply(el.lte(ct_base));
  var coolTemperateSubalpine = coolTemperate.multiply(el.gt(ct_base)         .and(el.lte(ct_base.add(500))));
  var coolTemperateAlpine    = coolTemperate.multiply(el.gt(ct_base.add(500)).and(el.lte(ct_base.add(750))));
  var coolTemperateNival     = coolTemperate.multiply(el.gt(ct_base.add(750)));

  // ── BOREAL (x1 = 3) ──────────────────────────────────────────────
  var borealBasal  = boreal.multiply(el.lte(bor_base));
  var borealAlpine = boreal.multiply(el.gt(bor_base).and(el.lte(bor_base.add(500))));
  var borealNival  = boreal.multiply(el.gt(bor_base.add(500)));

  // ── SUBPOLAR (x1 = 1.5) ──────────────────────────────────────────
  var subpolarBasal = subpolar.multiply(el.lte(sp_base));
  var subpolarNival = subpolar.multiply(el.gt(sp_base));

  // ── POLAR ─────────────────────────────────────────────────────────
  var polarZone = polar;

  // -- Precipitation & PET ratios --
  var map       = tcPre.sum().rename('precipitation');
  var petRatio  = annualPet.divide(map).rename('petRatio');
  var nMap      = map.divide(62.5).log().divide(ee.Number(2).log()).add(1);
  var nPetRatio = petRatio.divide(0.125).log().divide(ee.Number(2).log()).add(1);

  var ch = function(petRatioMax) {
    var nMax = ee.Image(petRatioMax).divide(0.125).log().divide(ee.Image(2).log()).add(1).add(1);
    return nMap.add(nMax.subtract(nPetRatio)).divide(2);
  };

  var chT  = ch(32);
  var chSW = ch(16);
  var chC  = ch(8);
  var chB  = ch(4);
  var chSP = ch(2);

  // -- Direct classification to the 27 IPCC GEZ codes --
  //
  // The HLZ→GEZ remap is fully determined by (altitudinal level, moisture
  // class). Adjacent HLZ moisture buckets that map to the same GEZ class
  // are merged into a single threshold. Each altitudinal level draws on a
  // single moisture index (chT/chSW/chC/chB/chSP), so we group all belts
  // sharing that level into one mutually-exclusive belt mask.
  //
  // Belt masks are 0/1 and pairwise disjoint, so .or() == .add(); using
  // .add() avoids extra logical ops in the graph.
  var beltGez1 = tropicalBasal;                                                     // chT
  var beltGez2 = tropicalPremontane.add(subtropicalBasal);                          // chSW
  var beltGez3 = tropicalLowerMontane.add(subtropicalLowerMontane)
                                     .add(warmTemperateBasal);                     // chSW
  var beltGez4 = tropicalMontane.add(subtropicalMontane)
                                .add(warmTemperateMontane)
                                .add(coolTemperateBasal);                          // chC
  var beltGez5 = tropicalSubalpine.add(subtropicalSubalpine)
                                  .add(warmTemperateSubalpine)
                                  .add(coolTemperateSubalpine)
                                  .add(borealBasal);                               // chB
  var beltGez6 = tropicalAlpine.add(subtropicalAlpine)
                               .add(warmTemperateAlpine)
                               .add(coolTemperateAlpine)
                               .add(borealAlpine)
                               .add(subpolarBasal);                                // chSP
  var beltGez7 = tropicalNival.add(subtropicalNival)
                              .add(warmTemperateNival)
                              .add(coolTemperateNival)
                              .add(borealNival)
                              .add(subpolarNival)
                              .add(polarZone);                                     // single class

  var parts = [
    // ── GEZ 1x  (Tropical basal, chT) ────────────────────────────────
    beltGez1.multiply(chT.gt(6)).multiply(11),
    beltGez1.multiply(chT.gt(5).and(chT.lte(6))).multiply(12),
    beltGez1.multiply(chT.gt(4).and(chT.lte(5))).multiply(13),
    beltGez1.multiply(chT.gt(2).and(chT.lte(4))).multiply(14),
    beltGez1.multiply(chT.lte(2)).multiply(15),

    // ── GEZ 2x  (Subtropical, chSW) ──────────────────────────────────
    beltGez2.multiply(chSW.gt(6)).multiply(21),
    beltGez2.multiply(chSW.gt(5).and(chSW.lte(6))).multiply(22),
    beltGez2.multiply(chSW.gt(4).and(chSW.lte(5))).multiply(23),
    beltGez2.multiply(chSW.gt(2).and(chSW.lte(4))).multiply(24),
    beltGez2.multiply(chSW.lte(2)).multiply(25),

    // ── GEZ 3x  (Warm Temperate, chSW) ───────────────────────────────
    beltGez3.multiply(chSW.gt(6)).multiply(31),
    beltGez3.multiply(chSW.gt(5).and(chSW.lte(6))).multiply(32),
    beltGez3.multiply(chSW.gt(4).and(chSW.lte(5))).multiply(33),
    beltGez3.multiply(chSW.gt(2).and(chSW.lte(4))).multiply(34),
    beltGez3.multiply(chSW.lte(2)).multiply(35),

    // ── GEZ 4x  (Cool Temperate, chC) ────────────────────────────────
    beltGez4.multiply(chC.gt(5)).multiply(41),
    beltGez4.multiply(chC.gt(4).and(chC.lte(5))).multiply(42),
    beltGez4.multiply(chC.gt(2).and(chC.lte(4))).multiply(43),
    beltGez4.multiply(chC.lte(2)).multiply(44),

    // ── GEZ 5x  (Boreal, chB) ────────────────────────────────────────
    beltGez5.multiply(chB.gt(4)).multiply(51),
    beltGez5.multiply(chB.gt(3).and(chB.lte(4))).multiply(52),
    beltGez5.multiply(chB.gt(2).and(chB.lte(3))).multiply(53),
    beltGez5.multiply(chB.lte(2)).multiply(54),

    // ── GEZ 6x  (Subpolar, chSP) ─────────────────────────────────────
    beltGez6.multiply(chSP.gt(3)).multiply(61),
    beltGez6.multiply(chSP.gt(2).and(chSP.lte(3))).multiply(62),
    beltGez6.multiply(chSP.lte(2)).multiply(63),

    // ── GEZ 71  (Polar / all nival belts) ────────────────────────────
    beltGez7.multiply(71)
  ];

  // Cast every part to a common type + band name so ImageCollection.sum()
  // sees a homogeneous collection. Max possible value is 71, fits in Int16.
  var castParts = parts.map(function(img) {
    return img.toInt16().rename('b');
  });

  return ee.ImageCollection.fromImages(castParts).sum();
};

// =========================================================================
// Public entry point — kept as `gez(...)` for compatibility with the rest
// of the script. The HLZ→GEZ remap is now fused into the classification
// above, so no separate .remap() step is needed.
// =========================================================================
var gez = function(startYear, endYear) {
  return holdridgeLifeZones(startYear, endYear);
};

// =========================================================================
// Build the GEZ image ONCE and reuse for the map layer and both exports.
// (Calling gez() three times re-runs the whole computation graph each time.)
// =========================================================================
var gezImage = gez(START_YEAR, END_YEAR);

// =========================================================================
// Visualization
// =========================================================================
var sld_intervals =
'<RasterSymbolizer>' +
  '<ColorMap type="intervals" extended="false">' +
    '<ColorMapEntry color="#C71D31" quantity="11" label="Tropical rainforest"/>' +
    '<ColorMapEntry color="#D64758" quantity="12" label="Tropical moist forest"/>' +
    '<ColorMapEntry color="#E37280" quantity="13" label="Tropical dry forest"/>' +
    '<ColorMapEntry color="#EEA0A9" quantity="14" label="Tropical shrubland"/>' +
    '<ColorMapEntry color="#F7CED3" quantity="15" label="Tropical desert"/>' +
    '<ColorMapEntry color="#F17C1D" quantity="21" label="Subtropical rain forest"/>' +
    '<ColorMapEntry color="#F89646" quantity="22" label="Subtropical moist forest"/>' +
    '<ColorMapEntry color="#FDB071" quantity="23" label="Subtropical dry forest"/>' +
    '<ColorMapEntry color="#FFCA9E" quantity="24" label="Subtropical shrubland"/>' +
    '<ColorMapEntry color="#FFE4CE" quantity="25" label="Subtropical desert"/>' +
    '<ColorMapEntry color="#FFDD00" quantity="31" label="Temperate rain forest"/>' +
    '<ColorMapEntry color="#FFE833" quantity="32" label="Temperate moist forest"/>' +
    '<ColorMapEntry color="#FFF066" quantity="33" label="Temperate dry forest"/>' +
    '<ColorMapEntry color="#FFF799" quantity="34" label="Temperate shrubland"/>' +
    '<ColorMapEntry color="#FFFCCC" quantity="35" label="Temperate desert"/>' +
    '<ColorMapEntry color="#74A900" quantity="41" label="Cool Temperate rain/wet forest"/>' +
    '<ColorMapEntry color="#9BC444" quantity="42" label="Cool Temperate moist forest"/>' +
    '<ColorMapEntry color="#C0DC88" quantity="43" label="Cool Temperate steppe"/>' +
    '<ColorMapEntry color="#E5F1CC" quantity="44" label="Cool Temperate desert"/>' +
    '<ColorMapEntry color="#009F49" quantity="51" label="Boreal rain/wet forest"/>' +
    '<ColorMapEntry color="#44BD79" quantity="52" label="Boreal moist forest"/>' +
    '<ColorMapEntry color="#88D7AA" quantity="53" label="Boreal dry scrub"/>' +
    '<ColorMapEntry color="#CCEFDA" quantity="54" label="Boreal desert"/>' +
    '<ColorMapEntry color="#0088D6" quantity="61" label="Subpolar rain/wet tundra"/>' +
    '<ColorMapEntry color="#66B9ED" quantity="62" label="Subpolar moist tundra"/>' +
    '<ColorMapEntry color="#CCE8FB" quantity="63" label="Subpolar dry tundra"/>' +
    '<ColorMapEntry color="#1451a0" quantity="71" label="Polar"/>' +
  '</ColorMap>' +
'</RasterSymbolizer>';

Map.addLayer(
  gezImage.sldStyle(sld_intervals),
  {},
  'IPCC GEZ (HLZ Level 1) - TerraClimate ' + START_YEAR + '-' + END_YEAR
);

// =========================================================================
// Legend
// =========================================================================
var legend = ui.Panel({ style: { maxHeight: '800px', position: 'bottom-right', padding: '8px 15px' } });
legend.add(ui.Label({
  value: 'Global Ecological Zones (TerraClimate)',
  style: { fontWeight: 'bold', fontSize: '14px', margin: '0 0 4px 0', padding: '0' }
}));

var makeRow = function(color, name) {
  return ui.Panel({
    widgets: [
      ui.Label({ style: { backgroundColor: '#' + color, padding: '8px', margin: '0 0 4px 0' } }),
      ui.Label({ value: name, style: { margin: '0 0 4px 6px' } })
    ],
    layout: ui.Panel.Layout.Flow('horizontal')
  });
};

var palette = [
  'C71D31', 'D64758', 'E37280', 'EEA0A9', 'F7CED3',
  'F17C1D', 'F89646', 'FDB071', 'FFCA9E', 'FFE4CE',
  'FFDD00', 'FFE833', 'FFF066', 'FFF799', 'FFFCCC',
  '74A900', '9BC444', 'C0DC88', 'E5F1CC',
  '009F49', '44BD79', '88D7AA', 'CCEFDA',
  '0088D6', '66B9ED', 'CCE8FB',
  '1451a0'
];
var names = [
  'Tropical rainforest', 'Tropical moist forest', 'Tropical dry forest',
  'Tropical shrubland', 'Tropical desert',
  'Subtropical rain forest', 'Subtropical moist forest', 'Subtropical dry forest',
  'Subtropical steppe/shrubland', 'Subtropical desert',
  'Warm Temperate rain/wet forest', 'Warm Temperate moist forest',
  'Warm Temperate dry forest', 'Warm Temperate steppe/shrubland', 'Warm Temperate desert',
  'Cool Temperate rain/wet forest', 'Cool Temperate moist forest',
  'Cool Temperate steppe', 'Cool Temperate desert',
  'Boreal rain/wet forest', 'Boreal moist forest', 'Boreal dry scrub', 'Boreal desert',
  'Subpolar rain/wet tundra', 'Subpolar moist tundra', 'Subpolar dry tundra',
  'Polar desert'
];
for (var i = 0; i < 27; i++) { legend.add(makeRow(palette[i], names[i])); }
Map.add(legend);

// =========================================================================
// Export
// =========================================================================
Export.image.toDrive({
  image: gezImage,
  description: 'IPCC_GEZ_HLZ_Level1_TerraClimate_' + START_YEAR + '-' + END_YEAR,
  scale: 1000,
  fileFormat: 'GeoTIFF',
  maxPixels: 1e13
});

Export.image.toAsset({
  image: gezImage,
  description: 'HoldridgeLifeZones/IPCC_GEZ_HLZ_Level1_TerraClimate_' + START_YEAR + '-' + END_YEAR,
  scale: 1000,
  maxPixels: 1e13
});
